# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/taskpulse

# Auth - use a long random secret (32+ characters)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# Comma-separated allowed frontend origins (set to your deployed frontend URL in production)
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# First Admin created by `npm run seed`
ADMIN_NAME=TaskPulse Admin
ADMIN_EMAIL=admin@taskpulse.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_PHONE=+1 555 0100
